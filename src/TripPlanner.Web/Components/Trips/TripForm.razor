@inherits ApiComponentBase
@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" OnValidSubmit="SubmitAsync" FormName="trip-form">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="Model.Name" />
        <ValidationMessage For="@(() => Model.Name)" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <InputTextArea id="description" rows="3" class="form-control" @bind-Value="Model.Description" />
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="startDate">Start date</label>
            <InputDate id="startDate" class="form-control" @bind-Value="Model.StartDate" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="endDate">End date</label>
            <InputDate id="endDate" class="form-control" @bind-Value="Model.EndDate" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
    }

    <div class="tp-modal-actions mt-4">
        <div class="tp-modal-actions-start">
            <button type="submit" class="btn btn-primary" disabled="@_isSubmitting"><ActionIcon Name="@(IsEdit ? "save" : "add")" CssClass="me-1 align-text-bottom" />@(IsEdit ? "Save trip" : "Create trip")</button>
        </div>
        @if (OnCancel.HasDelegate || !string.IsNullOrWhiteSpace(CancelHref))
        {
            <div class="tp-modal-actions-end">
                @if (OnCancel.HasDelegate)
                {
                    <button type="button" id="trip-cancel" class="btn btn-outline-secondary" disabled="@_isSubmitting" @onclick="OnCancel"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Cancel</button>
                }
                else
                {
                    <a class="btn btn-outline-secondary" href="@CancelHref"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Cancel</a>
                }
            </div>
        }
    </div>
</EditForm>

@code {
    public sealed class TripFormModel
    {
        [Required(ErrorMessage = "Trip name is required.")]
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddDays(1);
    }

    [Parameter] public TripFormModel Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string? CancelHref { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TripFormModel> OnSubmit { get; set; }

    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        if (DateOnly.FromDateTime(Model.EndDate) < DateOnly.FromDateTime(Model.StartDate))
        {
            _errorMessage = "The trip end date must be on or after the start date.";
            return;
        }
        _isSubmitting = true;

        await CallApiAsync(
            () => OnSubmit.InvokeAsync(Model),
            message => _errorMessage = message);

        _isSubmitting = false;
    }
}
