@inherits ApiComponentBase
@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" OnValidSubmit="SubmitAsync" FormName="trip-form">
    <DataAnnotationsValidator />
    <div class="card-body">
    <div class="mb-3">
        <label class="form-label" for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="Model.Name" />
        <ValidationMessage For="@(() => Model.Name)" />
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="startDate">Start date</label>
            <InputDate TValue="DateTime" id="startDate" class="form-control" Value="Model.StartDate" ValueChanged="@((DateTime value) => OnStartDateChanged(value))" ValueExpression="@(() => Model.StartDate)" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="endDate">End date</label>
            <InputDate TValue="DateTime" id="endDate" class="form-control" min="@Model.StartDate.ToString("yyyy-MM-dd")" Value="Model.EndDate" ValueChanged="@((DateTime value) => OnEndDateChanged(value))" ValueExpression="@(() => Model.EndDate)" />
        </div>
    </div>
    <div class="mb-3 mt-3">
        <label class="form-label" for="description">Description</label>
        <InputTextArea id="description" rows="3" class="form-control" @bind-Value="Model.Description" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
    }

    </div>
    <div class="card-footer entry-form-footer">
        <div class="entry-form-actions d-flex flex-wrap justify-content-start gap-3 w-100">
            <button type="submit" class="btn btn-primary" title="@(IsEdit ? "Save changes to this trip" : "Create this new trip")" disabled="@_isSubmitting"><ActionIcon Name="@(IsEdit ? "save" : "add")" CssClass="me-1 align-text-bottom" />@(IsEdit ? "Save" : "Create trip")</button>
            @if (OnCancel.HasDelegate || !string.IsNullOrWhiteSpace(CancelHref))
            {
                @if (OnCancel.HasDelegate)
                {
                    <button type="button" id="trip-cancel" class="btn btn-outline-secondary" title="Cancel without saving changes to this trip" disabled="@_isSubmitting" @onclick="OnCancel"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Cancel</button>
                }
                else
                {
                    <a class="btn btn-outline-secondary" title="Cancel without saving changes to this trip" href="@CancelHref"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Cancel</a>
                }
            }
        </div>
    </div>
</EditForm>

@code {
    public sealed class TripFormModel
    {
        [Required(ErrorMessage = "Trip name is required.")]
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today;
    }

    [Parameter] public TripFormModel Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string? CancelHref { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TripFormModel> OnSubmit { get; set; }

    private bool _isSubmitting;
    private string? _errorMessage;
    private bool _endDateChosen;

    protected override void OnParametersSet() => _endDateChosen |= IsEdit;

    private void OnStartDateChanged(DateTime value)
    {
        Model.StartDate = value;
        if (!_endDateChosen || Model.EndDate < value)
        {
            Model.EndDate = value;
        }
    }

    private void OnEndDateChanged(DateTime value)
    {
        _endDateChosen = true;
        Model.EndDate = value;
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        if (DateOnly.FromDateTime(Model.EndDate) < DateOnly.FromDateTime(Model.StartDate))
        {
            _errorMessage = "The trip end date must be on or after the start date.";
            return;
        }
        _isSubmitting = true;

        await CallApiAsync(
            () => OnSubmit.InvokeAsync(Model),
            message => _errorMessage = message);

        _isSubmitting = false;
    }
}
