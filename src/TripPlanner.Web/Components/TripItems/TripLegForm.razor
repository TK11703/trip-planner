@inherits ApiComponentBase
@using System.ComponentModel.DataAnnotations
@inject ITripApiClient TripApi

<EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="@FormName" class="d-flex flex-column overflow-hidden">
    <DataAnnotationsValidator />
    <div class="card-body">
    <div class="mb-3">
        <label class="form-label" for="leg-title">Name</label>
        <InputText id="leg-title" class="form-control" @bind-Value="_model.Title" />
        <ValidationMessage For="@(() => _model.Title)" />
    </div>
    <div class="row gx-2 gy-3 mb-3">
        <div class="@(_model.Kind == LegKind.Travel ? "col-12 col-md-3" : "col-12")">
            <fieldset>
                <legend class="form-label fs-6 mb-1">Leg type</legend>
                <InputRadioGroup @bind-Value="_model.Kind">
                    <div class="form-check form-check-inline">
                        <InputRadio class="form-check-input" id="leg-kind-travel" Value="LegKind.Travel" />
                        <label class="form-check-label" for="leg-kind-travel">Travel</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <InputRadio class="form-check-input" id="leg-kind-stay" Value="LegKind.Stay" />
                        <label class="form-check-label" for="leg-kind-stay">Stay</label>
                    </div>
                </InputRadioGroup>
            </fieldset>
        </div>
        @if (_model.Kind == LegKind.Travel)
        {
            <div class="col-12 col-md-9">
                <fieldset id="leg-transportation-mode">
                    <legend class="form-label fs-6 mb-1">Travel Mode</legend>
                    <InputRadioGroup @bind-Value="_model.TransportationMode">
                        <div class="btn-group leg-travel-modes">
                            @foreach (var mode in TransportationModes.All)
                            {
                                <InputRadio id="@($"leg-mode-{mode}")" class="btn-check" Value="@mode" />
                                <label class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center gap-2" for="@($"leg-mode-{mode}")">
                                    <ActionIcon Name="@mode" CssClass="flex-shrink-0" />
                                    @TransportationModes.Label(mode)
                                </label>
                            }
                        </div>
                    </InputRadioGroup>
                </fieldset>
                <ValidationMessage For="@(() => _model.TransportationMode)" />
            </div>
        }
    </div>
    @if (_model.Kind == LegKind.Travel && TransportationModes.IsValid(_model.TransportationMode) && !_model.CanContainItems)
    {
        <div class="alert alert-primary d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="note" data-testid="leg-item-restriction">
            <ActionIcon Name="info" CssClass="flex-shrink-0" />
            <span>You're a passenger on this leg, so you can't schedule stops along the way. Items belong on a stay or a car leg.</span>
        </div>
    }
    @if (_model.Kind == LegKind.Travel)
    {
        <div class="row gx-2 gy-3 mb-3">
            <div class="col-6">
                <label class="form-label" for="leg-origin">
                    Origin
                    <span class="text-secondary" role="note" data-testid="leg-origin-help" title="@OriginHelp">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="align-text-bottom" aria-hidden="true" focusable="false">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16Z" />
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588ZM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />
                        </svg>
                    </span>
                </label>
                <InputText id="leg-origin" class="form-control" placeholder="@PlacePlaceholder" @bind-Value="_model.Origin" />
                <ValidationMessage For="@(() => _model.Origin)" />
            </div>
            <div class="col-6">
                <label class="form-label" for="leg-destination">
                    Destination
                    <span class="text-secondary" role="note" data-testid="leg-destination-help" title="@DestinationHelp">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="align-text-bottom" aria-hidden="true" focusable="false">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16Z" />
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588ZM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />
                        </svg>
                    </span>
                </label>
                <InputText id="leg-destination" class="form-control" placeholder="@PlacePlaceholder" @bind-Value="_model.Destination" />
                <ValidationMessage For="@(() => _model.Destination)" />
            </div>
        </div>
    }
    <div class="card bg-body-tertiary shadow-none mb-3" id="leg-schedule" role="group" aria-label="Schedule">
        <div class="card-body p-3">
            <div class="row gx-2 gy-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="leg-start">Start</label>
                    <InputDate id="leg-start" Type="InputDateType.DateTimeLocal" class="form-control" min="@TripRangeMin" max="@TripRangeMax" step="60" @bind-Value="_model.StartAt" @bind-Value:after="OnStartChanged" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="leg-start-timezone">Start timezone</label>
                    <TimezoneSelect Id="leg-start-timezone" @bind-Value="_model.StartTimeZoneId" Placeholder="Select a timezone" />
                    <ValidationMessage For="@(() => _model.StartTimeZoneId)" />
                </div>
            </div>
            <div class="row gx-2 gy-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="leg-end">End</label>
                    <InputDate id="leg-end" Type="InputDateType.DateTimeLocal" class="form-control" min="@TripRangeMin" max="@TripRangeMax" step="60" @bind-Value="_model.EndAt" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="leg-end-timezone">End timezone</label>
                    <TimezoneSelect Id="leg-end-timezone" @bind-Value="_model.EndTimeZoneId" Placeholder="Select a timezone" />
                    <ValidationMessage For="@(() => _model.EndTimeZoneId)" />
                </div>
            </div>
        </div>
    </div>
    @if (_model.Kind == LegKind.Travel)
    {
        <div class="row gx-2 gy-3 mb-3">
            <div class="col-6">
                <label class="form-label" for="leg-confirmation-code">Confirmation/Reservation Code <span class="text-body-secondary fw-normal">(optional)</span></label>
                <InputText id="leg-confirmation-code" class="form-control" @bind-Value="_model.ConfirmationCode" />
                <ValidationMessage For="@(() => _model.ConfirmationCode)" />
            </div>
            <div class="col-6">
                <label class="form-label" for="leg-travel-cost">Cost <span class="text-body-secondary fw-normal">(optional)</span></label>
                <InputNumber id="leg-travel-cost" class="form-control" step="0.01" @bind-Value="_model.TravelCost" />
                <ValidationMessage For="@(() => _model.TravelCost)" />
            </div>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
    </div>
    </div>
    <div class="card-footer entry-form-footer">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger py-2 small mb-0">@_error</div>
        }
        <div class="entry-form-actions d-flex flex-wrap justify-content-start gap-3 w-100">
            <button type="submit" class="btn btn-primary" title="@(IsEdit ? "Save changes to this trip leg" : "Save this new leg to the trip")" disabled="@(_submitting || _deleting)"><ActionIcon Name="save" CssClass="me-1 align-text-bottom" />Save</button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" id="leg-cancel" class="btn btn-outline-secondary" title="Cancel without saving this trip leg" disabled="@(_submitting || _deleting)" @onclick="OnCancel"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Cancel</button>
            }
            @if (CanDelete)
            {
                <button type="button" id="leg-delete" class="btn btn-outline-danger ms-auto" title="Confirm deletion of this trip leg" disabled="@(_submitting || _deleting)" @onclick="RequestDelete"><ActionIcon Name="delete" CssClass="me-1 align-text-bottom" />Delete</button>
            }
        </div>
    </div>
</EditForm>

@if (_confirmDelete)
{
    <div class="modal d-block" role="dialog" aria-modal="true" aria-labelledby="leg-delete-title" data-testid="leg-delete-confirm">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="leg-delete-title">Delete leg</h2>
                    <button type="button" class="btn-close" aria-label="Close" title="Close without deleting this trip leg" disabled="@_deleting" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this leg: <strong>@_model.Title</strong>?</p>
                    <p class="mb-0">This can't be undone. Items on this leg have to be moved off it first.</p>
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@_error</div>
                    }
                </div>
                <div class="modal-footer gap-3">
                    <button type="button" class="btn btn-outline-secondary" title="Cancel deletion and keep this trip leg" disabled="@_deleting" @onclick="CancelDelete"><ActionIcon Name="cancel" CssClass="me-1 align-text-bottom" />Keep leg</button>
                    <button type="button" id="leg-delete-confirm" class="btn btn-danger" title="Permanently delete this trip leg" disabled="@_deleting" @onclick="DeleteLegAsync"><ActionIcon Name="delete" CssClass="me-1 align-text-bottom" />@(_deleting ? "Deleting…" : "Delete")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    public enum LegKind { Travel, Stay }

    private string OriginHelp => $"Where this leg starts. {PlaceHint}";

    private string DestinationHelp => $"Where this leg ends. {PlaceHint}";

    private string PlaceHint => _model.TransportationMode switch
    {
        TransportationModes.Flight => "Use an airport name or code, like Washington Dulles or IAD.",
        TransportationModes.Train => "Use a station name, city, or address, like Union Station.",
        TransportationModes.Bus => "Use a station or stop name, city, or address, like Greyhound Terminal.",
        TransportationModes.Boat => "Use a port or terminal name, city, or address, like Port of Miami.",
        TransportationModes.Car => "Use an address, city, or place name.",
        _ => "Use a place name, city, or address."
    };

    private string PlacePlaceholder => _model.TransportationMode switch
    {
        TransportationModes.Flight => "Airport name or code, like IAD",
        TransportationModes.Train => "Station name, city, or address",
        TransportationModes.Bus => "Station or stop name, city, or address",
        TransportationModes.Boat => "Port or terminal name, city, or address",
        TransportationModes.Car => "Address, city, or place name",
        _ => "Place name, city, or address"
    };

    private sealed class LegModel : IValidatableObject
    {
        [Required(ErrorMessage = "Name is required.")] public string Title { get; set; } = string.Empty;
        public LegKind Kind { get; set; } = LegKind.Travel;
        public string? TransportationMode { get; set; }
        public string? Origin { get; set; }
        public string? Destination { get; set; }
        private DateTime _startAt = MinutePrecision.Floor(DateTime.Now);
        private DateTime _endAt = MinutePrecision.Floor(DateTime.Now.AddHours(1));
        public DateTime StartAt { get => _startAt; set => _startAt = MinutePrecision.Floor(value); }
        public DateTime EndAt { get => _endAt; set => _endAt = MinutePrecision.Floor(value); }
        [Required(ErrorMessage = "Start timezone is required.")] public string StartTimeZoneId { get; set; } = "UTC";
        [Required(ErrorMessage = "End timezone is required.")] public string EndTimeZoneId { get; set; } = "UTC";
        public decimal? TravelCost { get; set; }
        public string? ConfirmationCode { get; set; }
        public string? Notes { get; set; }

        public string LegKindValue => Kind == LegKind.Stay ? TripLegKinds.Stay : TripLegKinds.Travel;

        public bool CanContainItems => TripLegEligibility.CanContainItems(LegKindValue, TransportationMode);

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Kind == LegKind.Travel && !TransportationModes.IsValid(TransportationMode))
            {
                yield return new ValidationResult("Choose how you are traveling.", new[] { nameof(TransportationMode) });
            }

            if (Kind == LegKind.Travel && string.IsNullOrWhiteSpace(Origin))
            {
                yield return new ValidationResult("Origin is required for a travel leg.", new[] { nameof(Origin) });
            }

            if (Kind == LegKind.Travel && string.IsNullOrWhiteSpace(Destination))
            {
                yield return new ValidationResult("Destination is required for a travel leg.", new[] { nameof(Destination) });
            }

            // Booking details are optional on every travel mode, so they are only checked once the
            // traveler has actually entered something.
            if (TravelCost is { } cost && Kind == LegKind.Travel)
            {
                if (cost < 0)
                {
                    yield return new ValidationResult("Cost cannot be negative.", new[] { nameof(TravelCost) });
                }
                else if (decimal.Round(cost, 2) != cost)
                {
                    yield return new ValidationResult("Enter a cost with up to two decimal places.", new[] { nameof(TravelCost) });
                }
            }

            if (Kind == LegKind.Travel && ConfirmationCode is { Length: > 255 })
            {
                yield return new ValidationResult("Confirmation/Reservation Code must be 255 characters or fewer.", new[] { nameof(ConfirmationCode) });
            }
        }
    }

    [Parameter] public Guid TripId { get; set; }
    [Parameter] public TripLegDto? Leg { get; set; }
    [Parameter] public DateOnly? TripStartDate { get; set; }
    [Parameter] public DateOnly? TripEndDate { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<bool> OnSubmittingChanged { get; set; }

    // Only an owner or a collaborator may remove a leg. Defaults to denied so a host that forgets
    // to pass it hides the action instead of offering one the API will reject.
    [Parameter] public bool CanEditContent { get; set; }

    private LegModel _model = new();
    private string? _error;
    private bool _submitting;
    private bool _confirmDelete;
    private bool _deleting;
    private Guid? _loadedLegId;
    private Guid? _defaultsLoadedForTripId;
    private Guid? _dateRangeLoadedForTripId;

    private bool IsEdit => Leg is not null;
    private bool CanDelete => IsEdit && CanEditContent;
    private string FormName => IsEdit ? $"trip-leg-edit-{Leg!.TripLegId}" : "trip-leg-create";
    private DateTime? TripRangeStart => TripStartDate?.ToDateTime(TimeOnly.MinValue);
    private DateTime? TripRangeEnd => TripEndDate?.ToDateTime(new TimeOnly(23, 59));
    private string? TripRangeMin => TripRangeStart?.ToString(MinutePrecision.PickerFormat);
    private string? TripRangeMax => TripRangeEnd?.ToString(MinutePrecision.PickerFormat);

    protected override void OnParametersSet()
    {
        if (Leg is null)
        {
            if (_loadedLegId is not null)
            {
                _model = new LegModel();
                _loadedLegId = null;
                _defaultsLoadedForTripId = null;
                _dateRangeLoadedForTripId = null;
                _confirmDelete = false;
            }

            if (_dateRangeLoadedForTripId != TripId && TripRangeStart is { } tripStart)
            {
                _model.StartAt = tripStart;
                var defaultEnd = tripStart.AddHours(1);
                _model.EndAt = TripRangeEnd is { } tripEnd && defaultEnd > tripEnd ? tripEnd : defaultEnd;
                _dateRangeLoadedForTripId = TripId;
            }
            return;
        }

        if (_loadedLegId == Leg.TripLegId)
        {
            return;
        }

        _confirmDelete = false;
        _model = new LegModel
        {
            Title = Leg.Title,
            // Fall back to the old origin-based reading so a leg saved before classifications
            // existed still opens as the kind the traveler sees on the timeline.
            Kind = (TripLegKinds.IsValid(Leg.LegKind) ? TripLegKinds.IsTravel(Leg.LegKind) : !string.IsNullOrWhiteSpace(Leg.Origin))
                ? LegKind.Travel
                : LegKind.Stay,
            TransportationMode = TransportationModes.Normalize(Leg.TransportationMode),
            Origin = Leg.Origin,
            Destination = Leg.Destination,
            StartAt = Leg.StartLocal,
            EndAt = Leg.EndLocal,
            StartTimeZoneId = Leg.StartTimeZoneId,
            EndTimeZoneId = Leg.EndTimeZoneId,
            TravelCost = Leg.TravelCost,
            ConfirmationCode = Leg.ConfirmationCode,
            Notes = Leg.Notes
        };
        _loadedLegId = Leg.TripLegId;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Leg is not null || _defaultsLoadedForTripId == TripId)
        {
            return;
        }

        var defaults = await TripApi.GetLegDefaultsAsync(TripId);
        if (defaults is not null)
        {
            _model.StartTimeZoneId = defaults.StartTimeZoneId;
            _model.EndTimeZoneId = defaults.EndTimeZoneId;
        }

        _defaultsLoadedForTripId = TripId;
    }

    private void OnStartChanged()
    {
        var end = _model.StartAt.AddHours(1);
        _model.EndAt = TripRangeEnd is { } tripEnd && end > tripEnd ? tripEnd : end;
    }

    private async Task SubmitAsync()
    {
        _error = null; _submitting = true;
        await OnSubmittingChanged.InvokeAsync(true);
        try
        {
            await CallApiAsync(SaveLegAsync, message => _error = message);
        }
        finally
        {
            _submitting = false;
            await OnSubmittingChanged.InvokeAsync(false);
        }
    }

    private void RequestDelete()
    {
        if (!CanDelete) return;

        _error = null;
        _confirmDelete = true;
    }

    private void CancelDelete() => _confirmDelete = false;

    private async Task DeleteLegAsync()
    {
        if (!CanDelete) return;

        _error = null; _deleting = true;
        await OnSubmittingChanged.InvokeAsync(true);
        try
        {
            await CallApiAsync(
                async () =>
                {
                    await TripApi.DeleteLegAsync(TripId, Leg!.TripLegId);
                    _confirmDelete = false;
                    await OnSaved.InvokeAsync();
                },
                // The API refuses to delete a leg that still holds items, and it says why, so the
                // confirmation stays open with that reason rather than closing on a silent failure.
                message => _error = message);
        }
        finally
        {
            _deleting = false;
            await OnSubmittingChanged.InvokeAsync(false);
        }
    }

    private async Task SaveLegAsync()
    {
        var isStay = _model.Kind == LegKind.Stay;
        var request = new CreateTripLegRequest(
            _model.Title.Trim(),
            isStay ? null : _model.Origin,
            isStay ? null : _model.Destination,
            _model.StartAt,
            _model.StartTimeZoneId,
            _model.EndAt,
            _model.EndTimeZoneId,
            _model.Notes,
            // A stay carries no travel-only data, so those values are dropped on the way out
            // rather than kept as hidden state the traveler cannot see.
            _model.LegKindValue,
            isStay ? null : TransportationModes.Normalize(_model.TransportationMode),
            isStay ? null : _model.TravelCost,
            isStay ? null : _model.ConfirmationCode);
        if (Leg is null)
        {
            await TripApi.CreateLegAsync(TripId, request);
            _model = new LegModel
            {
                Kind = _model.Kind,
                TransportationMode = _model.TransportationMode,
                StartTimeZoneId = request.EndTimeZoneId,
                EndTimeZoneId = request.EndTimeZoneId
            };
            _defaultsLoadedForTripId = null;
        }
        else
        {
            await TripApi.UpdateLegAsync(TripId, Leg.TripLegId, new UpdateTripLegRequest(
                request.Title,
                request.Origin,
                request.Destination,
                request.StartLocal,
                request.StartTimeZoneId,
                request.EndLocal,
                request.EndTimeZoneId,
                request.Notes,
                request.LegKind,
                request.TransportationMode,
                request.TravelCost,
                request.ConfirmationCode));
        }
        await OnSaved.InvokeAsync();
    }
}
