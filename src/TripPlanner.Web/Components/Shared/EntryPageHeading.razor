<header class="entry-page-heading">
    <div class="entry-page-intro">
        <span class="entry-page-icon"><ActionIcon Name="@Icon" /></span>
        <div class="entry-page-copy">
            <h1 tabindex="-1">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Context))
            {
                <p class="entry-page-subtitle">@Context</p>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="entry-page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Context { get; set; }
    [Parameter] public string Icon { get; set; } = "trip";
    [Parameter] public RenderFragment? Actions { get; set; }
}
