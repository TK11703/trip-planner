@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string>

<label id="@($"{Id}-label")" class="form-label" for="@Id">@Label</label>
<details class="item-color-dropdown" open="@_open" @onkeydown="OnKeyDown">
    <summary @ref="_summary" id="@Id" class="form-select d-flex align-items-center gap-2 @CssClass"
             aria-labelledby="@($"{Id}-label {Id}-name")"
             @onclick="() => _open = !_open" @onclick:preventDefault="true">
        <span class="item-color-preview" style="background-color: @SwatchColor(CurrentValue)" aria-hidden="true"></span>
        <span id="@($"{Id}-name")">@SelectedName</span>
    </summary>
    <div class="item-color-options shadow-sm" role="group" aria-label="@($"{Label} options")">
        @if (AllowNoPreference)
        {
            <button type="button" class="item-color-option" data-color="" aria-pressed="@(string.IsNullOrEmpty(CurrentValue) ? "true" : "false")" @onclick="() => SelectAsync(string.Empty)">
                <span class="item-color-preview" style="background-color: @SwatchColor(TrackedItemColors.All[0])" aria-hidden="true"></span>
                <span>@NoPreferenceName</span>
            </button>
        }
        @foreach (var color in TrackedItemColors.All)
        {
            <button type="button" class="item-color-option" data-color="@color" aria-pressed="@(string.Equals(CurrentValue, color, StringComparison.OrdinalIgnoreCase) ? "true" : "false")" @onclick="() => SelectAsync(color)">
                <span class="item-color-preview" style="background-color: @SwatchColor(color)" aria-hidden="true"></span>
                <span>@color</span>
            </button>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = "Color";
    [Parameter] public bool AllowNoPreference { get; set; }
    [CascadingParameter] private EntryNavigationGuard? NavigationGuard { get; set; }

    private bool _open;
    private ElementReference _summary;
    private static string NoPreferenceName => $"No preference ({TrackedItemColors.All[0]})";
    private string? SelectedName => AllowNoPreference && string.IsNullOrEmpty(CurrentValue) ? NoPreferenceName : CurrentValue;

    protected override bool TryParseValueFromString(string? value, out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }

    private async Task SelectAsync(string color)
    {
        CurrentValue = color;
        _open = false;
        await _summary.FocusAsync();
        if (NavigationGuard is not null)
        {
            await NavigationGuard.MarkDirtyAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
            await _summary.FocusAsync();
        }
    }

    private static string SwatchColor(string? color) => color?.ToLowerInvariant() switch
    {
        "slate" => "#64748b",
        "teal" => "#0d9488",
        "blue" => "#2563eb",
        "green" => "#2f7d57",
        "gold" => "#e7b85d",
        "orange" => "#c96f34",
        "red" => "#b42318",
        "purple" => "#7c3aed",
        "pink" => "#ec4899",
        "indigo" => "#4f46e5",
        "cyan" => "#06b6d4",
        "lime" => "#84cc16",
        "amber" => "#f59e0b",
        "brown" => "#92400e",
        "magenta" => "#c026d3",
        "navy" => "#1e3a8a",
        _ => "#64748b"
    };
}
