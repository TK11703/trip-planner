@page "/trips"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits ApiComponentBase
@inject ITripApiClient TripApi
@using TripPlanner.Web.Features.EntryPages

<PageTitle>Trips</PageTitle>

<EntryPageHeading Title="Trips" Context="Keep your upcoming and shared travel plans organized in one place — trips you own and trips shared with you." Icon="trip">
    <Actions>
        <a class="btn btn-primary" href="@EntryPageUrls.TripCreate(OriginHref)">New trip</a>
    </Actions>
</EntryPageHeading>

@if (_isLoading)
{
    <div class="text-secondary">Loading trips...</div>
}
else if (_error is not null)
{
    <PublicContentFallback Title="We couldn't load your trips right now." Detail="@_error" />
}
else if (_response.TotalCount == 0)
{
    <NoTripsEmptyState ReturnUrl="@OriginHref" />
}
else
{
    <div class="row g-3 mb-3">
        @foreach (var trip in _response.Trips)
        {
            <div class="col-md-6 col-lg-4">
                <TripCard Trip="trip" ShowAccess="true" ReturnUrl="@OriginHref" />
            </div>
        }
    </div>

    <nav aria-label="Trips pages" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="text-secondary small">
            Page @_response.Page of @TotalPages (@_response.TotalCount trips)
        </div>
        <div class="btn-group">
            <a class="btn btn-outline-secondary @(_response.Page <= 1 ? "disabled" : null)" aria-disabled="@(_response.Page <= 1)" href="@EntryPageUrls.TripsList(Math.Max(1, _response.Page - 1), _response.PageSize)">Previous</a>
            <a class="btn btn-outline-secondary @(_response.Page >= TotalPages ? "disabled" : null)" aria-disabled="@(_response.Page >= TotalPages)" href="@EntryPageUrls.TripsList(Math.Min(TotalPages, _response.Page + 1), _response.PageSize)">Next</a>
        </div>
    </nav>

    @if (MotivationalTravelFacts.ShouldShowFacts(_response))
    {
        <div class="mt-4">
            <MotivationalTravelFactList Secondary="true" />
        </div>
    }
}

@code {
    private const int DefaultPageSize = 12;
    [SupplyParameterFromQuery(Name = "page")] public int? RequestedPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public int? RequestedPageSize { get; set; }
    private int PageSize => Math.Clamp(RequestedPageSize ?? DefaultPageSize, 1, 100);
    private int Page => Math.Clamp(RequestedPage ?? 1, 1, 100000);
    private string OriginHref => EntryPageUrls.TripsList(Page, PageSize);
    private bool _isLoading = true;
    private string? _error;
    private TripListResponse _response = new(Array.Empty<TripSummary>(), 1, DefaultPageSize, 0);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_response.TotalCount / (double)_response.PageSize));

    protected override async Task OnParametersSetAsync() => await LoadPageAsync(Page);

    private async Task LoadPageAsync(int page)
    {
        _isLoading = true;
        _error = null;

        await CallApiAsync(
            async () => _response = await TripApi.GetTripsAsync(page, PageSize),
            message => _error = message);

        _isLoading = false;
    }
}
