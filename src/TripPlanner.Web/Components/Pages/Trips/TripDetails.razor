@page "/trips/{TripId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits ApiComponentBase
@inject ITripApiClient TripApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@using TripPlanner.Web.Features.EntryPages

<PageTitle>Trip details</PageTitle>

<EntryBreadcrumb Items="TripBreadcrumbs" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    @if (_trip is not null)
    {
        <span class="small text-secondary">View mode:</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="Itinerary view">
            <a class="btn @(_planningView == TripPlanningView.Table ? "btn-primary" : "btn-outline-primary")" aria-current="@(_planningView == TripPlanningView.Table ? "page" : null)" href="@TripViewHref(TripPlanningView.Table)">Table</a>
            <a class="btn @(_planningView == TripPlanningView.Timeline ? "btn-primary" : "btn-outline-primary")" aria-current="@(_planningView == TripPlanningView.Timeline ? "page" : null)" href="@TripViewHref(TripPlanningView.Timeline)">Timeline</a>
        </div>
    }
</div>

@if (_loading)
{
    <TripAccessState State="TripAccessState.TripAccessStateKind.Loading" />
}
else if (_trip is null)
{
    <TripAccessState State="TripAccessState.TripAccessStateKind.NotFoundOrDenied" />
}
else
{
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="mb-1">@_trip.Name</h1>
            <p class="text-secondary mb-0">@_trip.StartDate.ToLongDateString() - @_trip.EndDate.ToLongDateString()</p>
            @if (!_trip.IsOwner)
            {
                <span class="badge @AccessBadgeClass mt-2">Shared - @AccessLevelLabel</span>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (CanEditContent)
            {
                <a class="btn btn-sm btn-primary" href="@EntryPageUrls.TripEdit(TripId, CurrentTripReturn)"><ActionIcon Name="edit" CssClass="me-1 align-text-bottom" />Edit trip</a>
            }
            @if (_trip.IsOwner)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@($"/trips/{TripId}/print")"><ActionIcon Name="print" CssClass="me-1 align-text-bottom" />Print</a>
                <a class="btn btn-sm btn-outline-primary" href="@EntryPageUrls.TripSharing(TripId, CurrentTripReturn)"><ActionIcon Name="share" CssClass="me-1 align-text-bottom" />Share</a>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="OpenDeleteModal"><ActionIcon Name="delete" CssClass="me-1 align-text-bottom" />Delete trip</button>
            }
        </div>
    </header>

    <div class="row g-3">
        <div class="col-12">
            @{ var itinerary = TripPrintFormatting.BuildItineraryTable(_trip); }
            @if (itinerary.UnassignedItems.Count > 0)
            {
                <div class="alert alert-warning d-flex align-items-start gap-3 mb-3" role="alert">
                    <ActionIcon Name="warning" CssClass="flex-shrink-0 fs-4" />
                    <div>
                        <h2 class="alert-heading h5 mb-1">Immediate Action Needed!</h2>
                        @(itinerary.UnassignedItems.Count == 1
                            ? "1 item is not related to a trip leg."
                            : $"{itinerary.UnassignedItems.Count} items are not related to a trip leg.")
                        Select one below to assign it to a leg.
                    </div>
                </div>
            }
            <div class="card shadow-sm mb-3 tp-static">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="fw-semibold">@(_planningView == TripPlanningView.Timeline ? "Trip timeline" : "Itinerary table")</div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (CanEditContent && itinerary.HasContent)
                        {
                            <a id="tp-table-add-leg" class="btn btn-sm btn-outline-primary" aria-label="Add leg" href="@EntryPageUrls.LegCreate(TripId, CurrentTripReturn)"><ActionIcon Name="add" CssClass="me-1 align-text-bottom" />Add leg</a>
                            <a id="tp-table-add-item" class="btn btn-sm btn-outline-primary" aria-label="Add item" href="@EntryPageUrls.ItemCreate(TripId, startLocal: _planningView == TripPlanningView.Timeline ? (_timeline?.CurrentDate ?? InitialDate)?.ToDateTime(TimeOnly.MinValue) : null, returnUrl: CurrentTripReturn)"><ActionIcon Name="add" CssClass="me-1 align-text-bottom" />Add item</a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                @onclick="OpenMapModal" disabled="@(!CanOpenMap)"
                                title="@(CanOpenMap ? "View all trip locations on a map" : "Add a location to an item to view the map")"
                                aria-label="View all trip locations on a map">
                            <ActionIcon Name="map" CssClass="me-1 align-text-bottom" />View map
                        </button>
                        @if (_planningView == TripPlanningView.Timeline)
                        {
                            var navDates = _timeline?.TripDates ?? (IReadOnlyList<DateOnly>)Array.Empty<DateOnly>();
                            var navCurrent = _timeline?.CurrentDate;
                            <div class="btn-group btn-group-sm" role="group" aria-label="Step timeline by day">
                                <button type="button" class="btn btn-outline-secondary"
                                        title="Previous day" aria-label="Go to previous day"
                                        disabled="@(_timeline is null || _timeline.AtTripStart)"
                                        @onclick="GoToPreviousDayAsync">
                                    <span aria-hidden="true">&lsaquo;</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary"
                                        title="Next day" aria-label="Go to next day"
                                        disabled="@(_timeline is null || _timeline.AtTripEnd)"
                                        @onclick="GoToNextDayAsync">
                                    <span aria-hidden="true">&rsaquo;</span>
                                </button>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Jump to a date in the trip"
                                        disabled="@(navDates.Count == 0)">
                                    Jump to date@(navCurrent is { } jc ? $": {jc:ddd M/d}" : "")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end tp-jump-menu">
                                    <li><h6 class="dropdown-header">Shortcuts</h6></li>
                                    <li><button type="button" class="dropdown-item" @onclick="GoToTripStartAsync">Trip start</button></li>
                                    @if (_timeline?.TodayInRange == true)
                                    {
                                        <li><button type="button" class="dropdown-item" @onclick="GoToTodayAsync">Today</button></li>
                                    }
                                    <li><button type="button" class="dropdown-item" @onclick="GoToTripEndAsync">Trip end</button></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Dates</h6></li>
                                    @foreach (var date in navDates)
                                    {
                                        var jumpDate = date;
                                        var isActive = navCurrent == jumpDate;
                                        <li>
                                            <button type="button"
                                                    class="dropdown-item d-flex justify-content-between align-items-center @(isActive ? "active" : null)"
                                                    @onclick="() => JumpToDateAsync(jumpDate)">
                                                <span>@jumpDate.ToString("ddd, MMM d")</span>
                                                @if (isActive)
                                                {
                                                    <span class="ms-2" aria-hidden="true">&#10003;</span>
                                                }
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body @(itinerary.HasContent ? "tp-itinerary-flush" : null)">
                    @if (_planningView == TripPlanningView.Timeline)
                    {
                        <TripTimeline @ref="_timeline" TripId="@TripId" ReturnUrl="@CurrentTripReturn" InitialDate="@InitialDate" CanEdit="@CanEditContent" OnLoaded="HandleTimelineLoaded" OnActiveDateChanged="HandleActiveDateChanged" />
                    }
                    else
                    {
                        <TripItineraryTable Model="@itinerary" TripId="@TripId" ReturnUrl="@CurrentTripReturn" CanEdit="@CanEditContent" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card mb-3">
                <div class="card-header">Overview</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(_trip.Description))
                    {
                        <p class="mb-2">@_trip.Description</p>
                    }
                    else
                    {
                        <p class="text-secondary mb-2">No description yet.</p>
                    }
                    <div class="small text-secondary">Created @_trip.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card mb-3">
                <div class="card-header">Itinerary summary</div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between"><span>Legs</span><span>@_trip.Legs.Count</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Items</span><span>@_trip.TrackedItems.Count</span></li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Estimated total</span>
                        @if (_trip.EstimatedCostTotal > 0)
                        {
                            <span>@_trip.EstimatedCostTotal.ToDisplayAmount()</span>
                        }
                        else
                        {
                            <span class="text-secondary">No estimates yet</span>
                        }
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>People with access</span>
                    @if (_trip.IsOwner)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@EntryPageUrls.TripSharing(TripId, CurrentTripReturn)">Manage</a>
                    }
                </div>
                @{
                    var sharedPeople = _trip.SharedPeople ?? Array.Empty<TripShareMember>();
                    var hasMembers = sharedPeople.Any(p => p.AccessLevel != TripAccessLevel.Owner);
                }
                @if (sharedPeople.Count == 0)
                {
                    <div class="card-body">
                        @if (_trip.IsOwner)
                        {
                            <p class="text-secondary mb-0">This trip isn't shared yet. Select Share to invite viewers or collaborators.</p>
                        }
                        else
                        {
                            <p class="text-secondary mb-0">No one else has access to this trip yet.</p>
                        }
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var person in sharedPeople)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <span class="text-truncate">@(string.IsNullOrWhiteSpace(person.DisplayName) ? person.Email ?? person.UserId : person.DisplayName)</span>
                                <span class="badge @AccessBadge(person.AccessLevel)">
                                    @AccessText(person.AccessLevel)
                                </span>
                            </li>
                        }
                    </ul>
                    @if (_trip.IsOwner && !hasMembers)
                    {
                        <div class="card-body py-2">
                            <p class="text-secondary small mb-0">Only you have access. Select Manage to invite viewers or collaborators.</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (_showMapModal)
    {
        <TripPlanner.Web.Components.Trips.TripMapModal TripId="@TripId" ReturnUrl="@CurrentTripReturn" OnClose="CloseMapModal" />
    }

    @if (_showDeleteModal)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5">Delete trip</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDeleteModal" disabled="@_isDeleting"></button>
                    </div>
                    <div class="modal-body">
                        @if (_deleteError is not null)
                        {
                            <div class="alert alert-danger small" role="alert">@_deleteError</div>
                        }
                        <p class="mb-0">Are you sure you want to delete <strong>@_trip.Name</strong>? This permanently removes the trip and all of its legs, items, and shares. This can't be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal" disabled="@_isDeleting">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="HandleTripDeleteAsync" disabled="@_isDeleting"><ActionIcon Name="delete" CssClass="me-1 align-text-bottom" />@(_isDeleting ? "Deleting…" : "Delete trip")</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
}

@code {
    [Parameter] public Guid TripId { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "date")] public DateOnly? InitialDate { get; set; }
    private string CurrentTripReturn => EntryPageUrls.TripDetails(TripId, _planningView == TripPlanningView.Timeline ? "timeline" : "table", _timeline?.CurrentDate ?? InitialDate);
    private IReadOnlyList<BreadcrumbItem> TripBreadcrumbs => [new("Home", "/"), new("Trips", "/trips"), new(_trip?.Name ?? "Trip", IsCurrent: true)];
    private string TripViewHref(TripPlanningView view) => EntryPageUrls.TripDetails(TripId, view == TripPlanningView.Timeline ? "timeline" : "table", _timeline?.CurrentDate ?? InitialDate);

    private bool _loading = true;
    private TripDetail? _trip;
    private TripTimeline? _timeline;
    private Guid? _loadedTripId;
    private TripPlanningView _planningView = TripPlanningView.Table;
    private bool _showMapModal;
    private bool _showDeleteModal;
    private bool _isDeleting;
    private string? _deleteError;

    private enum TripPlanningView
    {
        Timeline,
        Table
    }

    private bool CanEditContent => _trip is not null && (_trip.IsOwner || _trip.AccessLevel == TripAccessLevel.Collaborator);
    private bool CanOpenMap => _trip is not null && _trip.TrackedItems.Any(i => IsLocationMappable(i.Location));
    private string AccessLevelLabel => _trip?.AccessLevel == TripAccessLevel.Collaborator ? "Collaborator" : "Viewer";
    private string AccessBadgeClass => _trip?.AccessLevel == TripAccessLevel.Collaborator ? "text-bg-success" : "text-bg-secondary";

    // Matches the globe's rule: a location is map-capable when non-empty, has a letter/digit, and is <=200 chars.
    private static bool IsLocationMappable(string? location)
    {
        if (string.IsNullOrWhiteSpace(location))
        {
            return false;
        }
        var trimmed = location.Trim();
        return trimmed.Length <= 200 && trimmed.Any(char.IsLetterOrDigit);
    }

    private static string AccessBadge(TripAccessLevel level) => level switch
    {
        TripAccessLevel.Owner => "text-bg-dark",
        TripAccessLevel.Collaborator => "text-bg-success",
        _ => "text-bg-secondary"
    };

    private static string AccessText(TripAccessLevel level) => level switch
    {
        TripAccessLevel.Owner => "Owner",
        TripAccessLevel.Collaborator => "Collaborator",
        _ => "Viewer"
    };

    protected override async Task OnParametersSetAsync()
    {
        _planningView = string.Equals(View, "timeline", StringComparison.OrdinalIgnoreCase) ? TripPlanningView.Timeline : TripPlanningView.Table;
        if (_loadedTripId != TripId) { _loadedTripId = TripId; await ReloadAsync(); }

    }

    private async Task ReloadAsync()
    {
        if (_trip is null)
        {
            _loading = true;
        }
        await CallApiAsync(
            async () =>
            {
                _trip = await TripApi.GetDetailAsync(TripId);
            },
            _ => _trip = null);

        // A lost token cache sends the browser back through Entra; stay on "Loading" until it
        // leaves rather than briefly claiming the trip does not exist.
        _loading = IsReauthenticating;
        if (_timeline is not null && !IsReauthenticating)
        {
            await _timeline.RefreshAsync();
        }
        StateHasChanged();
    }

    private void OpenDeleteModal()
    {
        _deleteError = null;
        _isDeleting = false;
        _showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (_isDeleting) return;
        _showDeleteModal = false;
        _deleteError = null;
    }

    private async Task HandleTripDeleteAsync()
    {
        _deleteError = null;
        _isDeleting = true;
        try { await TripApi.DeleteTripAsync(TripId); Nav.NavigateTo("/trips"); }
        catch { _deleteError = "We couldn't delete this trip. Please try again."; _isDeleting = false; }
    }

    private void OpenMapModal() => _showMapModal = true;

    private void CloseMapModal() => _showMapModal = false;

    private Task HandleMapOpenItemAsync(Guid trackedItemId)
    {
        _showMapModal = false;
        if (CanEditContent) Nav.NavigateTo(EntryPageUrls.ItemEdit(TripId, trackedItemId, CurrentTripReturn));
        return Task.CompletedTask;
    }

    private async Task JumpToDateAsync(DateOnly date)
    {
        if (_timeline is not null) await _timeline.ScrollToDateAsync(date);
    }

    private async Task GoToNextDayAsync()
    {
        if (_timeline is not null) await _timeline.GoToNextDayAsync();
    }

    private async Task GoToPreviousDayAsync()
    {
        if (_timeline is not null) await _timeline.GoToPreviousDayAsync();
    }

    private async Task GoToTripStartAsync()
    {
        if (_timeline is not null) await _timeline.GoToTripStartAsync();
    }

    private async Task GoToTripEndAsync()
    {
        if (_timeline is not null) await _timeline.GoToTripEndAsync();
    }

    private async Task GoToTodayAsync()
    {
        if (_timeline is not null) await _timeline.GoToTodayAsync();
    }

    private void HandleTimelineLoaded() => StateHasChanged();

    private void HandleActiveDateChanged(DateOnly activeDate)
    {
        var target = EntryPageUrls.TripDetails(TripId, "timeline", activeDate);
        var current = new Uri(Nav.Uri).PathAndQuery;
        if (!string.Equals(current, target, StringComparison.Ordinal)) Nav.NavigateTo(target, replace: true);
        StateHasChanged();
    }
}
