@page "/favorites"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits ApiComponentBase
@implements IDisposable
@using TripPlanner.Contracts.FavoriteDestinations
@using TripPlanner.Web.Components.Favorites
@using TripPlanner.Web.Features.FavoriteDestinations
@inject IFavoriteDestinationApiClient FavoriteApi

<PageTitle>Favorites</PageTitle>

<section class="favorites-page">
    <div class="mb-3">
        <h1 class="mb-1">Favorites</h1>
        <p class="text-secondary mb-0">Places you want to remember for a future trip.</p>
    </div>

    @if (_isLoading)
    {
        <p class="text-secondary" role="status">Loading favorites...</p>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-warning" role="alert">@_loadError</div>
    }
    else
    {
        <ul class="nav nav-tabs favorites-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button id="favorite-tab-list" type="button" role="tab" class="nav-link @(_activeTab == FavoritesTab.List ? "active" : null)" aria-selected="@(_activeTab == FavoritesTab.List ? "true" : "false")" aria-controls="favorite-panel-list" @onclick="ShowListTab">
                    Favorites
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button id="favorite-tab-import" type="button" role="tab" class="nav-link @(_activeTab == FavoritesTab.Import ? "active" : null)" aria-selected="@(_activeTab == FavoritesTab.Import ? "true" : "false")" aria-controls="favorite-panel-import" title="Import favorites from a JSON or CSV file" @onclick="ShowImportTab">
                    <ActionIcon Name="import" CssClass="me-1 align-text-bottom" />Import
                    @if (_openImport is { Status: FavoriteDestinationImportStatus.NeedsReview } && ReviewItemCount > 0)
                    {
                        <span class="badge rounded-pill text-bg-warning ms-1" data-testid="favorite-import-badge" title="@ReviewItemCount item@(ReviewItemCount == 1 ? null : "s") to review">@ReviewItemCount<span class="visually-hidden"> item@(ReviewItemCount == 1 ? null : "s") to review</span></span>
                    }
                    else if (_openImport is { Status: FavoriteDestinationImportStatus.Queued or FavoriteDestinationImportStatus.Processing })
                    {
                        <span class="spinner-border spinner-border-sm ms-1" data-testid="favorite-import-processing" title="Import in progress"><span class="visually-hidden">Import in progress</span></span>
                    }
                    else if (_openImport is { Status: FavoriteDestinationImportStatus.Failed })
                    {
                        <span class="badge rounded-pill text-bg-danger ms-1" data-testid="favorite-import-failed-badge" title="Import failed">!<span class="visually-hidden"> Import failed</span></span>
                    }
                </button>
            </li>
        </ul>

        @if (_activeTab == FavoritesTab.Import)
        {
            <div id="favorite-panel-import" role="tabpanel" aria-labelledby="favorite-tab-import">
                <FavoriteDestinationImport OnImported="ReloadFavoritesAsync" OnCancel="ShowListTab" OnImportChanged="ImportChanged" />
            </div>
        }
        else
        {
        <div id="favorite-panel-list" role="tabpanel" aria-labelledby="favorite-tab-list" class="card favorites-card">
            <div class="card-header">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-6">
                        <label class="visually-hidden" for="favorite-search">Search favorites</label>
                        <input id="favorite-search" class="form-control" type="search" placeholder="Search favorites" value="@_search" @oninput="SearchChangedAsync" />
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex flex-wrap gap-2 justify-content-md-end" role="toolbar" aria-label="Favorite actions">
                            <button id="favorite-add" type="button" class="btn btn-sm btn-primary" title="Add a new favorite" @onclick="ShowCreateForm">
                                <ActionIcon Name="add" CssClass="me-1 align-text-bottom" />New
                            </button>
                            <button id="favorite-delete-selected" type="button" class="btn btn-sm btn-outline-danger" title="Delete the selected favorites" disabled="@(SelectedFavorites.Count == 0)" @onclick="RequestBulkDelete">
                                <ActionIcon Name="delete" CssClass="me-1 align-text-bottom" />Delete@(SelectedFavorites.Count > 0 ? $" ({SelectedFavorites.Count})" : null)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (_saveMessage is not null)
                {
                    <div class="favorites-card-section">
                        <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2" role="status" data-testid="favorite-save-message">
                            <ActionIcon Name="success" CssClass="flex-shrink-0" />
                            <span>@_saveMessage</span>
                            <button id="favorite-save-message-close" type="button" class="btn-close" aria-label="Dismiss message" @onclick="DismissSaveMessage"></button>
                        </div>
                    </div>
                }

                @if (_favorites.Count == 0 && string.IsNullOrWhiteSpace(_search))
                {
                    <div class="favorites-card-section py-4 text-center">
                        <h2 class="h5">No favorite destinations yet</h2>
                        <p class="text-secondary">Save a place you have researched and keep its details here.</p>
                        <button id="favorite-add-empty" class="btn btn-primary" type="button" @onclick="ShowCreateForm">Add your first favorite</button>
                    </div>
                }
                else if (_favorites.Count == 0 && !string.IsNullOrWhiteSpace(_search))
                {
                    <p class="favorites-card-section text-secondary text-center py-4 mb-0" role="status">No favorites match your search.</p>
                }
                else if (_favorites.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle favorites-table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="favorites-select-col">
                                        <input id="favorite-select-all" class="form-check-input" type="checkbox" aria-label="Select all favorites" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                                    </th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Address</th>
                                    <th scope="col">City</th>
                                    <th scope="col">Country</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var favorite in _favorites)
                                {
                                    <tr @key="favorite.FavoriteDestinationId" class="@(_selectedIds.Contains(favorite.FavoriteDestinationId) ? "table-active" : null)">
                                        <td class="favorites-select-col">
                                            <input class="form-check-input" type="checkbox" aria-label="Select @favorite.Name" data-testid="favorite-select-@favorite.FavoriteDestinationId" checked="@_selectedIds.Contains(favorite.FavoriteDestinationId)" @onchange="args => ToggleSelection(favorite.FavoriteDestinationId, args)" />
                                        </td>
                                        <th scope="row">
                                            <button type="button" class="btn btn-link p-0 text-start fw-semibold" data-testid="favorite-edit-@favorite.FavoriteDestinationId" @onclick="() => EditFavorite(favorite)">@favorite.Name</button>
                                        </th>
                                        <td>@favorite.Address</td>
                                        <td>@favorite.City</td>
                                        <td>@favorite.Country</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        }
    }

    @if (_showForm || _editingFavorite is not null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="favoriteModalTitle">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="favoriteModalTitle">@(_editingFavorite is null ? "Add favorite" : "Edit favorite")</h2>
                        <button type="button" class="btn-close" aria-label="Close" disabled="@(_isSaving || _isDeleting)" @onclick="CancelForm"></button>
                    </div>
                    <FavoriteDestinationForm Favorite="_editingFavorite" OnCreate="CreateAsync" OnUpdate="UpdateAsync" OnCancel="CancelForm" OnDelete="RequestDelete" IsSaving="@(_isSaving || _isDeleting)" ErrorMessage="@_formError">
                        @if (_duplicateWarning is not null)
                        {
                            <div class="alert alert-warning mt-3 mb-0" role="alert" data-testid="favorite-duplicate-warning">
                                <p class="mb-2">This may be a possible duplicate. Save it as a separate favorite?</p>
                                <ul class="mb-2">
                                    @foreach (var match in _duplicateWarning.Matches)
                                    {
                                        <li>@match.Name, @match.Address</li>
                                    }
                                </ul>
                                <div class="d-flex gap-2">
                                    <button id="favorite-confirm-duplicate" type="button" class="btn btn-sm btn-warning" disabled="@_isSaving" @onclick="ConfirmDuplicateAsync">Save separately</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_isSaving" @onclick="CancelDuplicate">Cancel</button>
                                </div>
                            </div>
                        }
                        @if (_deleteCandidate is not null)
                        {
                            <div id="favorite-delete-confirm" class="alert alert-warning mt-3 mb-0" role="alert">
                                <p class="mb-2">Remove <strong>@_deleteCandidate.Name</strong> from your favorites? Existing trip items will not change.</p>
                                @if (_deleteError is not null)
                                {
                                    <p class="text-danger mb-2">@_deleteError</p>
                                }
                                <div class="d-flex gap-2">
                                    <button id="favorite-delete-confirm-action" type="button" class="btn btn-sm btn-danger" disabled="@_isDeleting" @onclick="DeleteFavoriteAsync">@(_isDeleting ? "Removing..." : "Remove favorite")</button>
                                    <button id="favorite-delete-cancel" type="button" class="btn btn-sm btn-outline-secondary" disabled="@_isDeleting" @onclick="CancelDelete">Keep favorite</button>
                                </div>
                            </div>
                        }
                    </FavoriteDestinationForm>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }

    @if (_showBulkDeleteConfirm)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="favoriteBulkDeleteTitle">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="favoriteBulkDeleteTitle">Delete favorites</h2>
                        <button type="button" class="btn-close" aria-label="Close" disabled="@_isBulkDeleting" @onclick="CancelBulkDelete"></button>
                    </div>
                    <div class="modal-body">
                        @if (_bulkDeleteError is not null)
                        {
                            <div class="alert alert-danger small" role="alert">@_bulkDeleteError</div>
                        }
                        <p class="mb-0">Remove <strong>@SelectedFavorites.Count</strong> selected favorite@(SelectedFavorites.Count == 1 ? null : "s")? Existing trip items will not change.</p>
                    </div>
                    <div class="modal-footer">
                        <button id="favorite-bulk-delete-cancel" type="button" class="btn btn-outline-secondary" disabled="@_isBulkDeleting" @onclick="CancelBulkDelete">Cancel</button>
                        <button id="favorite-bulk-delete-confirm" type="button" class="btn btn-danger" disabled="@_isBulkDeleting" @onclick="DeleteSelectedAsync">@(_isBulkDeleting ? "Deleting..." : "Delete favorites")</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
</section>

@code {
    private IReadOnlyList<FavoriteDestinationDto> _favorites = Array.Empty<FavoriteDestinationDto>();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _showForm;
    private FavoritesTab _activeTab = FavoritesTab.List;
    private bool _showBulkDeleteConfirm;
    private bool _isBulkDeleting;
    private string? _bulkDeleteError;
    private readonly HashSet<Guid> _selectedIds = [];
    private FavoriteDestinationDto? _editingFavorite;
    private FavoriteDestinationDto? _deleteCandidate;
    private string _search = string.Empty;
    private string? _loadError;
    private string? _formError;
    private string? _deleteError;
    private string? _saveMessage;
    private FavoriteDestinationDuplicateWarning? _duplicateWarning;
    private CreateFavoriteDestinationRequest? _pendingDuplicateRequest;
    private UpdateFavoriteDestinationRequest? _pendingDuplicateUpdate;
    private Guid? _pendingDuplicateFavoriteId;
    private int _searchRequestVersion;
    private CancellationTokenSource? _saveMessageTimer;
    private FavoriteDestinationImportJobDto? _openImport;
    private CancellationTokenSource? _importWatch;

    [Parameter] public TimeSpan SaveMessageDuration { get; set; } = TimeSpan.FromSeconds(5);
    [Parameter] public TimeSpan ImportPollInterval { get; set; } = TimeSpan.FromSeconds(3);

    // Flagged places plus possible duplicates that are not already flagged.
    private int ReviewItemCount
        => _openImport is null
            ? 0
            : _openImport.Ambiguities.Count
                + _openImport.PossibleDuplicates.Count(duplicate => _openImport.Ambiguities.All(ambiguity => ambiguity.RowNumber != duplicate.RowNumber));

    protected override async Task OnInitializedAsync()
    {
        await CallApiAsync(
            async () => _favorites = await FavoriteApi.GetAsync(),
            message => _loadError = message);
        // An import still running or waiting for review opens the Import tab; failing to check is not worth an error.
        await CallApiAsync(
            async () =>
            {
                _openImport = (await FavoriteApi.GetOpenImportsAsync()).FirstOrDefault();
                if (_openImport is not null)
                {
                    _activeTab = FavoritesTab.Import;
                }
            },
            _ => { });
        _isLoading = false;
    }

    private enum FavoritesTab
    {
        List,
        Import
    }

    private void ShowListTab()
    {
        _activeTab = FavoritesTab.List;
        StartImportWatch();
    }

    private void ShowImportTab()
    {
        _activeTab = FavoritesTab.Import;
        StopImportWatch();
        DismissSaveMessage();
    }

    private void ImportChanged(FavoriteDestinationImportJobDto? import)
        => _openImport = import;

    // The importer is not rendered on the Favorites tab, so the page keeps the tab badge current itself.
    private void StartImportWatch()
    {
        if (_importWatch is not null || _openImport is not { Status: FavoriteDestinationImportStatus.Queued or FavoriteDestinationImportStatus.Processing })
        {
            return;
        }

        _importWatch = new CancellationTokenSource();
        _ = WatchImportAsync(_importWatch);
    }

    private void StopImportWatch()
    {
        _importWatch?.Cancel();
        _importWatch = null;
    }

    private async Task WatchImportAsync(CancellationTokenSource source)
    {
        var cancellationToken = source.Token;
        try
        {
            while (!cancellationToken.IsCancellationRequested
                && _openImport is { Status: FavoriteDestinationImportStatus.Queued or FavoriteDestinationImportStatus.Processing } import)
            {
                await Task.Delay(ImportPollInterval, cancellationToken);
                await CallApiAsync(
                    async () =>
                    {
                        var latest = await FavoriteApi.GetImportAsync(import.ImportId, cancellationToken);
                        if (cancellationToken.IsCancellationRequested)
                        {
                            return;
                        }

                        if (latest?.Status == FavoriteDestinationImportStatus.Completed)
                        {
                            _openImport = null;
                            _favorites = await FavoriteApi.GetAsync(_search, cancellationToken);
                            ShowSaveMessage($"{latest.ImportedCount} destination{(latest.ImportedCount == 1 ? string.Empty : "s")} imported");
                            return;
                        }

                        _openImport = latest;
                    },
                    _ => { });
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_importWatch, source))
            {
                _importWatch = null;
            }
            source.Dispose();
        }
    }

    // Only rows currently listed count, so a search filter never deletes hidden selections.
    private IReadOnlyList<FavoriteDestinationDto> SelectedFavorites
        => _favorites.Where(favorite => _selectedIds.Contains(favorite.FavoriteDestinationId)).ToArray();

    private bool AllVisibleSelected
        => _favorites.Count > 0 && _favorites.All(favorite => _selectedIds.Contains(favorite.FavoriteDestinationId));

    private void ToggleSelection(Guid favoriteDestinationId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _selectedIds.Add(favoriteDestinationId);
        }
        else
        {
            _selectedIds.Remove(favoriteDestinationId);
        }
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        foreach (var favorite in _favorites)
        {
            if (args.Value is true)
            {
                _selectedIds.Add(favorite.FavoriteDestinationId);
            }
            else
            {
                _selectedIds.Remove(favorite.FavoriteDestinationId);
            }
        }
    }

    private void RequestBulkDelete()
    {
        if (SelectedFavorites.Count == 0)
        {
            return;
        }

        _bulkDeleteError = null;
        _saveMessage = null;
        _showBulkDeleteConfirm = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteConfirm = false;
        _bulkDeleteError = null;
    }

    private async Task DeleteSelectedAsync()
    {
        var ids = SelectedFavorites.Select(favorite => favorite.FavoriteDestinationId).ToArray();
        if (ids.Length == 0)
        {
            return;
        }

        _isBulkDeleting = true;
        _bulkDeleteError = null;
        await CallApiAsync(
            async () =>
            {
                var deleted = await FavoriteApi.DeleteManyAsync(ids);
                if (deleted is null)
                {
                    _bulkDeleteError = "The selected favorites could not be removed. Refresh and try again.";
                    return;
                }

                _selectedIds.ExceptWith(ids);
                _showBulkDeleteConfirm = false;
                _favorites = await FavoriteApi.GetAsync(_search);
                ShowSaveMessage($"{deleted} favorite{(deleted == 1 ? string.Empty : "s")} removed");
            },
            message => _bulkDeleteError = message);
        _isBulkDeleting = false;
    }

    private void ShowCreateForm()
    {
        _editingFavorite = null;
        _formError = null;
        _saveMessage = null;
        _duplicateWarning = null;
        _pendingDuplicateRequest = null;
        CancelDelete();
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _editingFavorite = null;
        _formError = null;
        _duplicateWarning = null;
        _pendingDuplicateRequest = null;
        _pendingDuplicateUpdate = null;
        _pendingDuplicateFavoriteId = null;
        CancelDelete();
    }

    private void EditFavorite(FavoriteDestinationDto favorite)
    {
        _showForm = false;
        _editingFavorite = favorite;
        _formError = null;
        _saveMessage = null;
        ClearDuplicateWarning();
        CancelDelete();
    }

    private async Task SearchChangedAsync(ChangeEventArgs eventArgs)
    {
        _search = eventArgs.Value?.ToString() ?? string.Empty;
        var requestVersion = ++_searchRequestVersion;
        await CallApiAsync(
            async () =>
            {
                var results = await FavoriteApi.GetAsync(_search);
                if (requestVersion == _searchRequestVersion)
                {
                    _favorites = results;
                }
            },
            message => _loadError = message);
    }

    private async Task ReloadFavoritesAsync()
    {
        await CallApiAsync(
            async () => _favorites = await FavoriteApi.GetAsync(_search),
            message => _loadError = message);
    }

    private async Task CreateAsync(CreateFavoriteDestinationRequest request)
        => await SaveAsync(request);

    private async Task ConfirmDuplicateAsync()
    {
        if (_pendingDuplicateRequest is not null)
        {
            await SaveAsync(_pendingDuplicateRequest with { ConfirmPossibleDuplicate = true });
        }
        else if (_pendingDuplicateUpdate is not null && _pendingDuplicateFavoriteId is { } favoriteId)
        {
            await UpdateAsync(favoriteId, _pendingDuplicateUpdate with { ConfirmPossibleDuplicate = true });
        }
    }

    private async Task SaveAsync(CreateFavoriteDestinationRequest request)
    {
        _isSaving = true;
        _formError = null;
        _saveMessage = null;

        await CallApiAsync(
            async () =>
            {
                var result = await FavoriteApi.CreateAsync(request);
                if (result.DuplicateWarning is not null)
                {
                    _pendingDuplicateRequest = request;
                    _pendingDuplicateUpdate = null;
                    _pendingDuplicateFavoriteId = null;
                    _duplicateWarning = result.DuplicateWarning;
                    return;
                }
                if (!result.Succeeded)
                {
                    _formError = result.ErrorMessage ?? "The favorite destination could not be saved.";
                    return;
                }

                _favorites = await FavoriteApi.GetAsync(_search);
                ClearDuplicateWarning();
                _showForm = false;
                ShowSaveMessage("Favorite destination saved");
            },
            message => _formError = message);

        _isSaving = false;
    }

    private async Task UpdateAsync(UpdateFavoriteDestinationRequest request)
    {
        if (_editingFavorite is null)
        {
            return;
        }

        await UpdateAsync(_editingFavorite.FavoriteDestinationId, request);
    }

    private async Task UpdateAsync(Guid favoriteDestinationId, UpdateFavoriteDestinationRequest request)
    {
        _isSaving = true;
        _formError = null;
        _saveMessage = null;

        await CallApiAsync(
            async () =>
            {
                var result = await FavoriteApi.UpdateAsync(favoriteDestinationId, request);
                if (result.DuplicateWarning is not null)
                {
                    _pendingDuplicateRequest = null;
                    _pendingDuplicateUpdate = request;
                    _pendingDuplicateFavoriteId = favoriteDestinationId;
                    _duplicateWarning = result.DuplicateWarning;
                    return;
                }
                if (!result.Succeeded)
                {
                    _formError = result.ErrorMessage ?? "The favorite destination could not be updated.";
                    return;
                }

                _favorites = await FavoriteApi.GetAsync(_search);
                _editingFavorite = null;
                ClearDuplicateWarning();
                ShowSaveMessage("Favorite destination updated");
            },
            message => _formError = message);

        _isSaving = false;
    }

    private void RequestDelete()
    {
        _deleteCandidate = _editingFavorite;
        _deleteError = null;
        ClearDuplicateWarning();
    }

    private void CancelDelete()
    {
        _deleteCandidate = null;
        _deleteError = null;
    }

    private async Task DeleteFavoriteAsync()
    {
        if (_deleteCandidate is null)
        {
            return;
        }

        var favoriteId = _deleteCandidate.FavoriteDestinationId;
        _isDeleting = true;
        _deleteError = null;
        await CallApiAsync(
            async () =>
            {
                if (!await FavoriteApi.DeleteAsync(favoriteId))
                {
                    _deleteError = "The favorite could not be removed. Refresh and try again.";
                    return;
                }

                _deleteCandidate = null;
                _editingFavorite = null;
                _favorites = await FavoriteApi.GetAsync(_search);
                ShowSaveMessage("Favorite destination removed");
            },
            message => _deleteError = message);
        _isDeleting = false;
    }

    private void CancelDuplicate()
    {
        ClearDuplicateWarning();
    }

    private void ClearDuplicateWarning()
    {
        _duplicateWarning = null;
        _pendingDuplicateRequest = null;
        _pendingDuplicateUpdate = null;
        _pendingDuplicateFavoriteId = null;
    }

    private void ShowSaveMessage(string message)
    {
        StopSaveMessageTimer();
        _saveMessage = message;
        _saveMessageTimer = new CancellationTokenSource();
        _ = HideSaveMessageAsync(_saveMessageTimer.Token);
    }

    private async Task HideSaveMessageAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(SaveMessageDuration, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _saveMessage = null;
                StateHasChanged();
            }
        });
    }

    private void DismissSaveMessage()
    {
        StopSaveMessageTimer();
        _saveMessage = null;
    }

    private void StopSaveMessageTimer()
    {
        _saveMessageTimer?.Cancel();
        _saveMessageTimer?.Dispose();
        _saveMessageTimer = null;
    }

    public void Dispose()
    {
        StopSaveMessageTimer();
        StopImportWatch();
    }
}