{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "platformResourceGroup": {
      "value": "${AZURE_PLATFORM_RESOURCE_GROUP=rg-platform}"
    },
    "containerAppsEnvironmentName": {
      "value": "${AZURE_CONTAINER_APPS_ENVIRONMENT_NAME=cae-shared}"
    },
    "postgresServerName": {
      "value": "${AZURE_POSTGRES_SERVER_NAME=accpsqlshared}"
    },
    "registryName": {
      "value": "${AZURE_CONTAINER_REGISTRY_NAME=acccrshared}"
    },
    "registryResourceGroup": {
      "value": "${AZURE_CONTAINER_REGISTRY_RESOURCE_GROUP=rg-platform}"
    },
    "postgresPassword": {
      "value": "${POSTGRES_PASSWORD}"
    },
    "entraTenantId": {
      "value": "${AZURE_TENANT_ID}"
    },
    "entraWebClientId": {
      "value": "${AZURE_ENTRA_WEB_CLIENT_ID}"
    },
    "entraApiClientId": {
      "value": "${AZURE_ENTRA_API_CLIENT_ID}"
    },
    "entraDomain": {
      "value": "${AZURE_ENTRA_DOMAIN}"
    },
    "entraApiScope": {
      "value": "${AZURE_ENTRA_API_SCOPE}"
    },
    "releaseId": {
      "value": "${RELEASE_ID}"
    },
    "webImage": {
      "value": "${WEB_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}"
    },
    "apiImage": {
      "value": "${API_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}"
    },
    "azureOpenAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAiDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_NAME}"
    },
    "azureOpenAiResourceId": {
      "value": "${AZURE_OPENAI_RESOURCE_ID}"
    },
    "tripChatResourceId": {
      "value": "${TRIP_CHAT_RESOURCE_ID}"
    },
    "tripChatEndpoint": {
      "value": "${TRIP_CHAT_ENDPOINT}"
    },
    "tripChatChatDeploymentName": {
      "value": "${TRIP_CHAT_CHAT_DEPLOYMENT_NAME}"
    },
    "tripChatEmbeddingDeploymentName": {
      "value": "${TRIP_CHAT_EMBEDDING_DEPLOYMENT_NAME}"
    },
    "tripChatEmbeddingDimensions": {
      "value": "${TRIP_CHAT_EMBEDDING_DIMENSIONS=1536}"
    },
    "tripChatMaxMessageLength": {
      "value": "${TRIP_CHAT_MAX_MESSAGE_LENGTH=2000}"
    },
    "tripChatMaxPriorUserTurns": {
      "value": "${TRIP_CHAT_MAX_PRIOR_USER_TURNS=6}"
    },
    "tripChatRetrievalTopK": {
      "value": "${TRIP_CHAT_RETRIEVAL_TOP_K=12}"
    },
    "tripChatRateLimitPerMinute": {
      "value": "${TRIP_CHAT_RATE_LIMIT_PER_MINUTE=10}"
    },
    "tripChatIndexBatchSize": {
      "value": "${TRIP_CHAT_INDEX_BATCH_SIZE=100}"
    },
    "tripChatTargetP95Milliseconds": {
      "value": "${TRIP_CHAT_TARGET_P95_MILLISECONDS=8000}"
    },
    "azureMapsClientId": {
      "value": "${AZURE_MAPS_CLIENT_ID}"
    },
    "azureMapsEndpoint": {
      "value": "${AZURE_MAPS_ENDPOINT}"
    },
    "azureMapsResourceId": {
      "value": "${AZURE_MAPS_RESOURCE_ID}"
    },
    "emailRelayEnabled": {
      "value": "${EMAIL_RELAY_ENABLED=false}"
    },
    "emailRelayFolderPath": {
      "value": "${EMAIL_RELAY_FOLDER_PATH=Inbox}"
    },
    "emailRelayProcessedFolderPath": {
      "value": "${EMAIL_RELAY_PROCESSED_FOLDER_PATH=Processed}"
    }
  }
}
