# Copy to .env or use as a template for `dotnet user-secrets`.
# Real values are NEVER committed.

# Azure Entra (Web app registration)
AzureEntra__Instance=https://login.microsoftonline.com/
AzureEntra__Domain=your-tenant.onmicrosoft.com
AzureEntra__TenantId=00000000-0000-0000-0000-000000000000
AzureEntra__ClientId=00000000-0000-0000-0000-000000000000
AzureEntra__CallbackPath=/signin-oidc
AzureEntra__SignedOutCallbackPath=/signout-callback-oidc

# Azure Entra (API app registration / audience)
AzureEntra__Audience=api://00000000-0000-0000-0000-000000000000

# Azure OpenAI — required by the API for email recognition.
# Without the endpoint the API's readiness check reports Unhealthy and no booking email is ever
# recognized. Set both on the API project:
#   dotnet user-secrets set "AzureOpenAI:Endpoint" "https://<resource>.openai.azure.com/" --project src/TripPlanner.Api/TripPlanner.Api.csproj
#   dotnet user-secrets set "AzureOpenAI:DeploymentName" "<deployment>" --project src/TripPlanner.Api/TripPlanner.Api.csproj
# DeploymentName must match a deployment that actually exists on the resource; it is the
# deployment name rather than the model name, and the built-in default ("gpt-4o") is wrong for
# most resources.
# Authentication is DefaultAzureCredential, so `az login` must be signed in as an identity with a
# data-plane role on the resource ("Cognitive Services OpenAI User" or equivalent). Owner alone
# is not enough.
# For local runs the AppHost pins the credential chain to the Azure CLI by setting
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential, because DefaultAzureCredential would otherwise try
# Visual Studio first and a VS session signed in as a different account yields a valid token the
# data plane rejects with 401. Export AZURE_TOKEN_CREDENTIALS yourself to authenticate another
# way; see https://learn.microsoft.com/dotnet/azure/sdk/authentication/credential-chains for the
# accepted values.
AzureOpenAI__Endpoint=https://your-resource.openai.azure.com/
AzureOpenAI__DeploymentName=gpt-4o

# Aspire Postgres parameters
Parameters__postgres-user=tripplanner
Parameters__postgres-password=change-me
